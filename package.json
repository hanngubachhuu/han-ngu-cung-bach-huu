{
  "name": "han-ngu-cung-bach-huu",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build-study-data.mjs && node scripts/build-web.mjs",
    "build:lexicon": "node scripts/build-study-lexicon.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node --env-file-if-exists=.env.local scripts/dev-server.mjs",
    "validate:study": "node scripts/validate-study.mjs",
    "lint": "eslint study server api tests scripts/*study*.mjs scripts/build-web.mjs scripts/dev-server.mjs",
    "format": "prettier --write study/*.mjs study/study.css server/*.mjs api/*.js tests/*.mjs scripts/*study*.mjs scripts/build-web.mjs scripts/dev-server.mjs",
    "test:browser": "node scripts/check-study-browser.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "hanzi-writer": "3.7.3",
    "pinyin-pro": "3.27.0"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "esbuild": "0.25.10",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "hanzi-writer-data": "2.0.1",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "supabase": "2.117.0"
  }
}
