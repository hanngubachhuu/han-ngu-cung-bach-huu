[{"id":"hsk1_bai1--B01-G1","title":"Chào hỏi và xin lỗi","pattern":"","explanation":"你好 chào một người; 您好 lịch sự; 你们好 chào một nhóm. Đáp lời xin lỗi bằng 没关系.","examples":["你好！您好！你们好！对不起！—没关系！"],"curriculum":{"id":"hsk1_bai1","level":"1","lessonNo":1,"title":"你好！","href":"hsk1_bai1_index.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk1/bai1.js","sourceVersion":"f2b0abbaad1cf153","license":"project-content","sourceRefs":["S11:PDF14-19","S12:lesson1"],"lessonId":"hsk1_bai1"}},{"id":"hsk1_bai1--B01-G2","title":"Hai thanh ba liền nhau","pattern":"","explanation":"Trong lời nói liền mạch, thanh ba thứ nhất trong 你好 đọc gần thanh hai; pinyin từ điển vẫn viết nǐ hǎo.","examples":["你好 nǐ hǎo → khi nói: ní hǎo."],"curriculum":{"id":"hsk1_bai1","level":"1","lessonNo":1,"title":"你好！","href":"hsk1_bai1_index.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk1/bai1.js","sourceVersion":"f2b0abbaad1cf153","license":"project-content","sourceRefs":["S11:PDF14-19","S12:lesson1"],"lessonId":"hsk1_bai1"}},{"id":"hsk1_bai1--B01-G3","title":"Bật hơi và không bật hơi","pattern":"","explanation":"b/p, d/t, g/k khác nhau chủ yếu ở bật hơi. Không đồng nhất máy móc với chữ cái tiếng Việt.","examples":["Đặt tờ giấy trước miệng: p bật hơi rõ hơn b."],"curriculum":{"id":"hsk1_bai1","level":"1","lessonNo":1,"title":"你好！","href":"hsk1_bai1_index.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk1/bai1.js","sourceVersion":"f2b0abbaad1cf153","license":"project-content","sourceRefs":["S11:PDF14-19","S12:lesson1"],"lessonId":"hsk1_bai1"}},{"id":"hsk1_bai2--B02-G1","title":"Cảm ơn và tạm biệt","pattern":"","explanation":"Đáp 谢谢 bằng 不客气; dùng 再见 khi chia tay. Không dùng 没关系 như lời đáp cảm ơn trong cặp cơ bản của bài.","examples":["谢谢你！—不客气！再见！"],"curriculum":{"id":"hsk1_bai2","level":"1","lessonNo":2,"title":"谢谢你！","href":"hsk1_bai2_index.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk1/bai2.js","sourceVersion":"70a9db69c05b4063","license":"project-content","sourceRefs":["S11:PDF20-25","S13:lesson2"],"lessonId":"hsk1_bai2"}},{"id":"hsk1_bai2--B02-G2","title":"Thanh nhẹ","pattern":"","explanation":"Âm tiết nhẹ không mang dấu thanh; đọc ngắn và nhẹ, cao độ phụ thuộc âm trước.","examples":["xièxie; kèqi"],"curriculum":{"id":"hsk1_bai2","level":"1","lessonNo":2,"title":"谢谢你！","href":"hsk1_bai2_index.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk1/bai2.js","sourceVersion":"70a9db69c05b4063","license":"project-content","sourceRefs":["S11:PDF20-25","S13:lesson2"],"lessonId":"hsk1_bai2"}},{"id":"hsk1_bai2--B02-G3","title":"Ghi dấu thanh","pattern":"","explanation":"Ưu tiên a, rồi o/e; trong iu/ui đặt dấu ở nguyên âm đứng sau. Phân biệt quy tắc viết và cách phát âm.","examples":["hǎo; xiè; liù; huì"],"curriculum":{"id":"hsk1_bai2","level":"1","lessonNo":2,"title":"谢谢你！","href":"hsk1_bai2_index.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk1/bai2.js","sourceVersion":"70a9db69c05b4063","license":"project-content","sourceRefs":["S11:PDF20-25","S13:lesson2"],"lessonId":"hsk1_bai2"}},{"id":"hsk1_bai3--B03-G1","title":"什么 và vị trí từ hỏi","pattern":"","explanation":"Từ hỏi ở vị trí của thông tin cần hỏi; 什么 đứng trước 名字. Không thêm 吗 vào câu hỏi 什么 thông thường.","examples":["你叫什么名字？"],"curriculum":{"id":"hsk1_bai3","level":"1","lessonNo":3,"title":"你叫什么名字？","href":"hsk1_bai3_index.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk1/bai3.js","sourceVersion":"cc436aa47901c9f5","license":"project-content","sourceRefs":["S11:PDF26-33","S14:lesson3"],"lessonId":"hsk1_bai3"}},{"id":"hsk1_bai3--B03-G2","title":"是 và 不是","pattern":"","explanation":"是 nối chủ ngữ với danh từ chỉ thân phận; phủ định là 不是.","examples":["我是学生。我不是老师。"],"curriculum":{"id":"hsk1_bai3","level":"1","lessonNo":3,"title":"你叫什么名字？","href":"hsk1_bai3_index.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk1/bai3.js","sourceVersion":"cc436aa47901c9f5","license":"project-content","sourceRefs":["S11:PDF26-33","S14:lesson3"],"lessonId":"hsk1_bai3"}},{"id":"hsk1_bai3--B03-G3","title":"Câu hỏi 吗","pattern":"","explanation":"Giữ trật tự câu trần thuật rồi thêm 吗 cuối câu; đáp theo nội dung, không dùng 是 cho mọi động từ.","examples":["你是老师吗？—我不是老师。"],"curriculum":{"id":"hsk1_bai3","level":"1","lessonNo":3,"title":"你叫什么名字？","href":"hsk1_bai3_index.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk1/bai3.js","sourceVersion":"cc436aa47901c9f5","license":"project-content","sourceRefs":["S11:PDF26-33","S14:lesson3"],"lessonId":"hsk1_bai3"}},{"id":"hsk1_bai3--B03-G4","title":"不 và ü","pattern":"","explanation":"不 đọc bú trước thanh bốn nhưng bảng từ giữ bù. Sau j/q/x, ü viết thành u; sau n/l vẫn giữ hai chấm.","examples":["不是 bù shì (khi nói bú shì); nǚ; qù"],"curriculum":{"id":"hsk1_bai3","level":"1","lessonNo":3,"title":"你叫什么名字？","href":"hsk1_bai3_index.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk1/bai3.js","sourceVersion":"cc436aa47901c9f5","license":"project-content","sourceRefs":["S11:PDF26-33","S14:lesson3"],"lessonId":"hsk1_bai3"}},{"id":"hsk2_bai1_jiuyue--hsk2_bai1_jiuyue_g1","title":"Trợ động từ 要","pattern":"S + 要 + V + O","explanation":"Trong bài này, 要 đứng trước động từ để biểu thị mong muốn, ý định hoặc kế hoạch.","examples":["我要去北京旅游。","我们要不要买几个新的椅子？"],"curriculum":{"id":"hsk2_bai1_jiuyue","level":"2","lessonNo":1,"title":"九月去北京旅游最好","href":"bvnh2-1.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk2/bai1.js","sourceVersion":"8718468ed8531190","license":"project-content","sourceRefs":["textbook_lesson1"],"lessonId":"hsk2_bai1_jiuyue"}},{"id":"hsk2_bai1_jiuyue--hsk2_bai1_jiuyue_g2","title":"Phó từ 最","pattern":"S + 最 + Adj./V","explanation":"最 đứng trước tính từ hoặc động từ để biểu thị mức độ cao nhất.","examples":["九月去北京旅游最好。","我最喜欢踢足球。"],"curriculum":{"id":"hsk2_bai1_jiuyue","level":"2","lessonNo":1,"title":"九月去北京旅游最好","href":"bvnh2-1.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk2/bai1.js","sourceVersion":"8718468ed8531190","license":"project-content","sourceRefs":["textbook_lesson1"],"lessonId":"hsk2_bai1_jiuyue"}},{"id":"hsk2_bai1_jiuyue--hsk2_bai1_jiuyue_g3","title":"Số lượng ước lượng 几","pattern":"几 + 量词 + 名词","explanation":"几 biểu thị số lượng không xác định; trong phạm vi cơ bản của bài dùng cho số nhỏ hơn 10.","examples":["几个人","几本书","几个新的椅子"],"curriculum":{"id":"hsk2_bai1_jiuyue","level":"2","lessonNo":1,"title":"九月去北京旅游最好","href":"bvnh2-1.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk2/bai1.js","sourceVersion":"8718468ed8531190","license":"project-content","sourceRefs":["textbook_lesson1"],"lessonId":"hsk2_bai1_jiuyue"}},{"id":"hsk2_bai1_jiuyue--hsk2_bai1_jiuyue_g4","title":"Số lượng ước lượng 多","pattern":"Số + 量词 + 多 + 名词 / Số + 多 + 量词 + 名词","explanation":"Với số nhỏ hơn 10, 多 đứng sau lượng từ; với số từ 10 trở lên, 多 đứng trước lượng từ.","examples":["三点多","六个多月","十多个月","二十多块钱"],"curriculum":{"id":"hsk2_bai1_jiuyue","level":"2","lessonNo":1,"title":"九月去北京旅游最好","href":"bvnh2-1.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk2/bai1.js","sourceVersion":"8718468ed8531190","license":"project-content","sourceRefs":["textbook_lesson1"],"lessonId":"hsk2_bai1_jiuyue"}},{"id":"hsk2_bai2_liudian_qichuang--hsk2_bai2_liudian_qichuang_g1","title":"Câu hỏi với 是不是","pattern":"S + 是不是 + V/Adj...?","explanation":"Khi người nói đã có phỏng đoán khá chắc chắn về một sự việc hoặc tình huống và muốn xác nhận lại, có thể dùng 是不是. Mẫu này thường đứng trước vị ngữ, nhưng cũng có thể đứng ở đầu hoặc cuối câu.","examples":["你很少生病，是不是喜欢运动？","是不是明天爸爸休息？","我们星期一去北京，是不是？"],"curriculum":{"id":"hsk2_bai2_liudian_qichuang","level":"2","lessonNo":2,"title":"我每天六点起床","href":"bai2_index.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk2/bai2.js","sourceVersion":"b7d80216c621c35a","license":"project-content","sourceRefs":["textbook_p26"],"lessonId":"hsk2_bai2_liudian_qichuang"}},{"id":"hsk2_bai2_liudian_qichuang--hsk2_bai2_liudian_qichuang_g2","title":"Đại từ 每","pattern":"每 + 量词 / đơn vị thời gian + N","explanation":"每 đứng trước lượng từ hoặc đơn vị để chỉ từng cá thể hay từng nhóm bất kỳ trong tổng thể, như 每天、每年、每个月、每个星期.","examples":["山姆每年都去中国旅游。","你每个星期六都工作吗？","我每天六点起床。"],"curriculum":{"id":"hsk2_bai2_liudian_qichuang","level":"2","lessonNo":2,"title":"我每天六点起床","href":"bai2_index.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk2/bai2.js","sourceVersion":"b7d80216c621c35a","license":"project-content","sourceRefs":["textbook_p26"],"lessonId":"hsk2_bai2_liudian_qichuang"}},{"id":"hsk2_bai2_liudian_qichuang--hsk2_bai2_liudian_qichuang_g3","title":"Đại từ nghi vấn 多 + tính từ","pattern":"S + 多 + Adj.?","explanation":"多 đứng trước tính từ để hỏi về mức độ. Khi trả lời, cần đưa ra lượng hoặc mức độ cụ thể, ví dụ tuổi, chiều cao...","examples":["你多大？","王医生的儿子多高？","他多高？"],"curriculum":{"id":"hsk2_bai2_liudian_qichuang","level":"2","lessonNo":2,"title":"我每天六点起床","href":"bai2_index.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk2/bai2.js","sourceVersion":"b7d80216c621c35a","license":"project-content","sourceRefs":["textbook_p26"],"lessonId":"hsk2_bai2_liudian_qichuang"}},{"id":"hsk2_bai3_zuobian_hongse--hsk2_l03_g01","title":"“的”字短语","pattern":"[修饰成分] + 的","explanation":"Khi danh từ phía sau đã rõ trong ngữ cảnh, phần đứng trước 的 có thể dùng như một cụm danh ngữ, thường gặp ở sở hữu và mô tả đặc điểm.","examples":["我的","昨天的","红色的","左边那个红色的"],"curriculum":{"id":"hsk2_bai3_zuobian_hongse","level":"2","lessonNo":3,"title":"左边那个红色的是我的","href":"bai3_index.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk2/bai3.js","sourceVersion":"33a8536e841d6f76","license":"project-content","sourceRefs":["textbook_l03"],"lessonId":"hsk2_bai3_zuobian_hongse"}},{"id":"hsk2_bai3_zuobian_hongse--hsk2_l03_g02","title":"一下","pattern":"主语 + 动词 + 一下 (+ 宾语)","explanation":"一下 đứng sau động từ để biểu thị hành động ngắn hoặc làm cách nói nhẹ, tự nhiên hơn.","examples":["我看一下。"],"curriculum":{"id":"hsk2_bai3_zuobian_hongse","level":"2","lessonNo":3,"title":"左边那个红色的是我的","href":"bai3_index.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk2/bai3.js","sourceVersion":"33a8536e841d6f76","license":"project-content","sourceRefs":["textbook_l03"],"lessonId":"hsk2_bai3_zuobian_hongse"}},{"id":"hsk2_bai3_zuobian_hongse--hsk2_l03_g03","title":"语气副词“真”","pattern":"真 + 形容词 (+ 啊)","explanation":"真 đứng trước tính từ để bộc lộ cảm xúc, thường mang sắc thái cảm thán như “thật là, ... thật”.","examples":["房间真漂亮！","你女儿的房间真漂亮！"],"curriculum":{"id":"hsk2_bai3_zuobian_hongse","level":"2","lessonNo":3,"title":"左边那个红色的是我的","href":"bai3_index.html","standardVersion":"HSK 2.0"},"provenance":{"source":"data/lessons/hsk2/bai3.js","sourceVersion":"33a8536e841d6f76","license":"project-content","sourceRefs":["textbook_l03"],"lessonId":"hsk2_bai3_zuobian_hongse"}}]