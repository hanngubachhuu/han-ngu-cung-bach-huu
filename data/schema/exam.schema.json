{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanngubachhuu.github.io/han-ngu-cung-bach-huu/data/schema/exam.schema.json",
  "title": "Exam Definition",
  "description": "Mô tả phiên bản cấu trúc đề. Không hard-code cấu trúc đề vào giao diện.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "program", "version", "title", "sections", "sourceRefs"],
  "properties": {
    "id": { "type": "string" },
    "program": { "enum": ["hsk", "hskk"] },
    "levelId": { "type": "string" },
    "version": { "type": "string" },
    "effectiveFrom": { "type": ["string", "null"], "format": "date" },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vi"],
      "properties": {
        "zhHans": { "type": ["string", "null"] },
        "vi": { "type": "string" }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "skill", "itemCount"],
        "properties": {
          "id": { "type": "string" },
          "skill": { "type": "string" },
          "itemCount": { "type": "integer", "minimum": 0 },
          "durationSeconds": { "type": ["integer", "null"], "minimum": 0 },
          "scoreModel": { "type": ["string", "null"] },
          "itemTypes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "sourceRefs": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "status": { "enum": ["draft", "review", "published", "archived"] }
  }
}