{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://hanngubachhuu.github.io/han-ngu-cung-bach-huu/data/schema/hanzi.schema.json",
  "title":"Hán Ngữ Cùng Bách Hữu - Hanzi Profile",
  "type":"object",
  "additionalProperties":false,
  "required":["char","pinyin","meaning","hanViet","radical","structure","strokes","sourceRefs","status","readingProfile","deepProfile"],
  "properties":{
    "id":{"type":["string","null"]},
    "char":{"type":"string","minLength":1,"maxLength":1},
    "pinyin":{"type":"string","minLength":1},
    "hanViet":{"type":"string","minLength":1},
    "meaning":{"type":"string","minLength":1},
    "traditionalForm":{"type":["string","null"],"maxLength":1},
    "radical":{"type":"string","minLength":1,"maxLength":1},
    "structure":{"type":"string","minLength":1},
    "strokes":{"type":"integer","minimum":1},
    "components":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "exampleWords":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "sourceRefs":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},
    "status":{"enum":["pending","enriched_verified","review","published"]},
    "readingProfile":{
      "type":"object","additionalProperties":false,"required":["lessonReading","readings","note"],
      "properties":{
        "lessonReading":{"type":"string","minLength":1},
        "toneSandhi":{"type":"array"},
        "readings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["pinyin","pos","meaning","when"],"properties":{
          "pinyin":{"type":"string","minLength":1},"pos":{"type":"string","minLength":1},"meaning":{"type":"string","minLength":1},"when":{"type":"string","minLength":1},"examples":{"type":"array","items":{"type":"object"}}
        }}},
        "note":{"type":"string","minLength":1}
      }
    },
    "deepProfile":{
      "type":"object","additionalProperties":false,"required":["coreMeaning","usageNotes","commonConfusions","formation","historicalNotes","semanticPhoneticAnalysis"],
      "properties":{
        "coreMeaning":{"type":"string","minLength":1},
        "usageNotes":{"type":"array","items":{"type":"string"}},
        "commonConfusions":{"type":"array","items":{"type":"string"}},
        "formation":{"type":["object","null"],"additionalProperties":false,"properties":{
          "type":{"type":["string","null"]},"components":{"type":"array","items":{"type":"string"}},"semanticComponent":{"type":["string","null"]},"phoneticComponent":{"type":["string","null"]},"confidence":{"enum":["verified","supported","uncertain"]},"sourceRefs":{"type":"array","items":{"type":"string"},"uniqueItems":true}
        }},
        "historicalNotes":{"type":"array","items":{"type":"string"}},
        "semanticPhoneticAnalysis":{"type":["object","null"],"additionalProperties":false,"properties":{
          "isPhonoSemantic":{"type":["boolean","null"]},"semanticComponent":{"type":["string","null"]},"phoneticComponent":{"type":["string","null"]},"note":{"type":["string","null"]},"sourceRefs":{"type":"array","items":{"type":"string"},"uniqueItems":true}
        }},
        "hsk20LevelRefs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "hsk30Alignment":{"type":["object","null"]}
      }
    }
  }
}