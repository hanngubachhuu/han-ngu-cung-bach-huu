{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://hanngubachhuu.github.io/han-ngu-cung-bach-huu/data/schema/media.schema.json",
  "title":"Media Asset",
  "type":"object",
  "additionalProperties":false,
  "required":["id","entityType","mediaType","uri","status"],
  "properties":{
    "id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "entityType":{"const":"media"},
    "mediaType":{"enum":["audio","image","video","document"]},
    "uri":{"type":"string","minLength":1},
    "durationSeconds":{"type":["number","null"],"minimum":0},
    "mimeType":{"type":["string","null"]},
    "transcriptRef":{"type":["string","null"]},
    "license":{"type":["string","null"]},
    "sourceRef":{"type":["string","null"]},
    "status":{"enum":["draft","review","published","archived"]}
  }
}