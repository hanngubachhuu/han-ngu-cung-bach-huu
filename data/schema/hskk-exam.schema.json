{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HSKK shared exam configuration",
  "type": "object",
  "required": [
    "exam_code",
    "exam_version",
    "level",
    "title",
    "source_type",
    "sections",
    "questions",
    "audio",
    "timing"
  ],
  "properties": {
    "exam_code": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "exam_version": { "type": "integer", "minimum": 1 },
    "level": { "enum": ["elementary", "intermediate", "advanced"] },
    "source_type": { "enum": ["official", "mock", "teacher_created"] },
    "status": { "enum": ["draft", "unpublished", "published", "archived"] },
    "title": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title_vi", "preparation_seconds"],
        "properties": {
          "id": { "type": "string" },
          "title_vi": { "type": "string" },
          "title_zh": { "type": "string" },
          "preparation_seconds": { "type": "number", "minimum": 0 }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "number",
          "version",
          "section_id",
          "type",
          "prompt",
          "prompt_mode",
          "response_seconds",
          "auto_start",
          "auto_stop",
          "allow_replay",
          "allow_rerecord"
        ],
        "properties": {
          "id": { "type": "string" },
          "version_id": { "type": ["string", "null"] },
          "number": { "type": "integer", "minimum": 1 },
          "version": { "type": "integer", "minimum": 1 },
          "section_id": { "type": "string" },
          "type": {
            "enum": [
              "speaking_repeat",
              "speaking_answer",
              "speaking_long_answer",
              "picture_description",
              "read_aloud",
              "short_response",
              "long_response"
            ]
          },
          "prompt": { "type": "string" },
          "prompt_mode": { "enum": ["audio", "text", "image"] },
          "pinyin": { "type": ["string", "null"] },
          "response_seconds": {
            "type": ["number", "null"],
            "exclusiveMinimum": 0
          },
          "auto_start": { "type": "boolean" },
          "auto_stop": { "type": "boolean" },
          "allow_replay": { "type": "boolean" },
          "allow_rerecord": { "type": "boolean" },
          "audio_segment": {
            "type": ["object", "null"],
            "properties": {
              "start_seconds": { "type": "number", "minimum": 0 },
              "end_seconds": { "type": "number", "exclusiveMinimum": 0 },
              "verified": { "type": "boolean" }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "required": ["url", "duration_seconds"],
      "properties": {
        "mode": { "enum": ["single", "segmented", "multi_file"] },
        "url": { "type": "string" },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "source_audio_id": { "type": "string" }
      }
    },
    "timing": {
      "type": "object",
      "required": ["countdown_seconds"],
      "properties": {
        "countdown_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "provenance": { "type": "object" },
    "rubric": { "type": ["object", "null"] }
  }
}
