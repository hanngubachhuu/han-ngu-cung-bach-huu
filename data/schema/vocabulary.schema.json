{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanngubachhuu.github.io/han-ngu-cung-bach-huu/data/schema/vocabulary.schema.json",
  "title": "Vocabulary Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "entityType", "program", "headword", "pinyin", "meanings", "status", "version", "audit"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "entityType": { "const": "vocabulary" },
    "program": { "enum": ["hsk", "shared"] },
    "examSystemId": { "type": ["string", "null"] },
    "levelRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "headword": { "type": "string", "minLength": 1 },
    "traditional": { "type": ["string", "null"] },
    "pinyin": { "type": "string", "minLength": 1 },
    "meanings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vi"],
        "properties": {
          "vi": { "type": "string", "minLength": 1 },
          "senseId": { "type": ["string", "null"] },
          "usageNote": { "type": ["string", "null"] }
        }
      }
    },
    "partsOfSpeech": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "characterAnalysis": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "radicals": { "type": "array", "items": { "type": "string" } },
        "components": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": ["string", "null"] }
      }
    },
    "exampleRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "sourceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "status": { "enum": ["draft", "review", "published", "archived"] },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "schema"],
      "properties": {
        "content": { "type": "string" },
        "schema": { "type": "string" }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt", "updatedAt"],
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": ["string", "null"] },
        "updatedBy": { "type": ["string", "null"] }
      }
    }
  }
}